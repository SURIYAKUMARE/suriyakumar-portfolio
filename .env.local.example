# Supabase Configuration
# To connect your Supabase instance, replace these with your project URL and anon key:
# Find these in your Supabase Dashboard: Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Note: If these keys are not set, the portfolio automatically operates in offline/demo mode
# with seamless browser local persistence, so you can test and edit projects immediately!
